{
  "name": "hiper-vesika",
  "version": "0.1.0",
  "description": "Vesikalık fotoğraf düzenleme ve baskı dizme uygulaması",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "test": "npm run test:birim && npm run test:uctan-uca",
    "test:birim": "node --test \"test/*.test.js\"",
    "test:uctan-uca": "node --test --test-concurrency=1 \"test/uctan-uca/*.test.js\"",
    "lint": "eslint .",
    "lint:duzelt": "eslint . --fix",
    "paket:mac": "npm run vendor && electron-builder --mac --x64",
    "simge": "electron scripts/simge-uret.js",
    "vendor": "node scripts/vendor.js",
    "postinstall": "node scripts/vendor.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiperajans/hipervesika.git"
  },
  "keywords": [
    "vesikalik",
    "biyometrik-fotograf",
    "fotograf-dizme",
    "electron",
    "photo",
    "print"
  ],
  "author": "Hiper Ajans <software@hiperajans.com>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/hiperajans/hipervesika/issues"
  },
  "homepage": "https://github.com/hiperajans/hipervesika#readme",
  "devDependencies": {
    "@vladmandic/human-models": "^3.0.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "neostandard": "^0.13.0",
    "playwright-core": "^1.62.1"
  },
  "dependencies": {
    "@vladmandic/human": "^3.3.6",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1"
  }
}
